---
export interface Props {
	// "wordmark" is the one-line MAKER mark for the header; "full" adds "Srbija" below it.
	variant?: 'full' | 'wordmark';
}

const { variant = 'full' } = Astro.props as Props;
const image =
	variant === 'wordmark'
		? { src: '/logo-wordmark.png', width: 396, height: 160 }
		: { src: '/logo.png', width: 600, height: 330 };
---

<img class:list={['odyssey-logo', `odyssey-logo--${variant}`]} alt="Mejker Srbija" {...image} />

<style>
	.odyssey-logo {
		display: block;
		width: auto;
		height: 3rem;
	}
	.odyssey-logo--wordmark {
		height: 2rem;
		/* Header padding is 0.5rem; this lines the mark up with the 1rem page content edge. */
		margin-left: 0.5rem;
	}
	/* The navy logo disappears on the dark theme's near-black background, so render it white there. */
	:global([data-theme='dark']) .odyssey-logo {
		filter: brightness(0) invert(1);
	}
</style>
