---
import Layout from "../layouts/Page.astro";
import Container from "../components/core/Container.astro";
import { Icon } from "astro-icon";
// Past events data from meetup history (see src/data/events.json)
import eventsData from "../data/events.json";

const seo = {
  title: "Događaji - Mejker",
  description: "Prošli događaji udruženja Mejker Srbija",
};

const MONTHS = ["jan", "feb", "mar", "apr", "maj", "jun", "jul", "avg", "sep", "okt", "nov", "dec"];
const CITIES = [
  ["Novi Sad", /novi sad/i],
  ["Beograd", /beograd|belgrade/i],
  ["Šabac", /šabac/i],
  ["Zrenjanin", /zrenjanin/i],
  ["Sombor", /sombor/i],
];

// The overview strip spans from the first to the last event, padded by a month on each side.
const times = eventsData.map((e) => new Date(e.dateTime).getTime());
const MONTH_MS = 30 * 24 * 3600 * 1000;
const spanStart = Math.min(...times) - MONTH_MS;
const spanEnd = Math.max(...times) + MONTH_MS;
const toX = (t) => (((t - spanStart) / (spanEnd - spanStart)) * 100).toFixed(2);

const thumbOf = (src) => src.replace(/\/([^/]+)$/, "/thumb/$1");

const events = eventsData.map((event) => {
  const d = new Date(event.dateTime);
  const where = `${event.venue ?? ""} ${event.location}`;
  const city = (CITIES.find(([, re]) => re.test(where)) ?? ["Novi Sad"])[0];
  return {
    ...event,
    paragraphs: event.description.split(/\n{2,}/),
    year: d.getFullYear(),
    day: d.getDate(),
    month: MONTHS[d.getMonth()],
    city,
    x: toX(d.getTime()),
    photos: event.images.map((src) => ({ src, thumb: thumbOf(src) })),
    linkLabel: event.link?.includes("meetup.com")
      ? "Na Meetup-u"
      : event.link?.includes("youtube.com")
        ? "Pogledaj prilog"
        : "Pročitaj članak",
  };
});

const years = [...new Set(events.map((e) => e.year))].map((year) => ({
  year,
  events: events.filter((e) => e.year === year),
  x: Math.max(0, toX(new Date(year, 0, 1).getTime())),
}));

const cities = CITIES.map(([name]) => ({
  name,
  count: events.filter((e) => e.city === name).length,
})).filter((c) => c.count > 0);

const first = events[events.length - 1];
const PREVIEW = 4;
---

<Layout {seo}>
  <Container>
    <div class="events-page">
      <header class="intro">
        <h1>Događaji</h1>
        <p>
          Od prvog okupljanja u kafiću Sting {first.year}. organizujemo radionice, predavanja i
          festivale zajedno sa našom zajednicom, a priča se nastavlja.
        </p>
      </header>

      <nav class="overview" aria-label="Pregled događaja po vremenu">
        <div class="strip">
          <div class="strip-axis"></div>
          {years.map((y) => (
            <span class="strip-year" style={`left:${y.x}%`}>{y.year}</span>
          ))}
          {events.map((e) => (
            <a
              href={`#e-${e.id}`}
              class:list={["strip-dot", { "has-photos": e.photos.length > 0 }]}
              style={`left:${e.x}%`}
              data-id={e.id}
              data-city={e.city}
              title={`${e.title} (${e.date})`}
            >
              <span class="visually-hidden">{e.title}, {e.date}</span>
            </a>
          ))}
          <span class="strip-cursor" aria-hidden="true"></span>
        </div>
        <div class="filters" role="group" aria-label="Filtriraj po gradu">
          <button type="button" class="chip" data-city="" aria-pressed="true">
            Svi gradovi <span>{events.length}</span>
          </button>
          {cities.map((c) => (
            <button type="button" class="chip" data-city={c.name} aria-pressed="false">
              {c.name} <span>{c.count}</span>
            </button>
          ))}
        </div>
      </nav>

      <div class="timeline">
        <div class="trace" aria-hidden="true"><div class="trace-fill"></div></div>

        {years.map((y) => (
          <section class="year" data-year={y.year} aria-labelledby={`y-${y.year}`}>
            <h2 id={`y-${y.year}`} class="year-label">
              <span class="year-pad" aria-hidden="true"></span>
              {y.year}
            </h2>

            {y.events.map((e) => (
              <article class="entry" id={`e-${e.id}`} data-id={e.id} data-city={e.city}>
                <time class="when" datetime={e.dateTime}>
                  <span class="day">{e.day}</span>
                  <span class="month">{e.month}</span>
                </time>
                <span class="pad" aria-hidden="true"></span>

                <div class="body">
                  <h3>{e.title}</h3>
                  <p class="where" title={e.venue}>
                    <Icon name="ic:baseline-place" />
                    {e.location}
                  </p>
                  <p class="summary">{e.summary}</p>

                  {e.photos.length > 0 ? (
                    <div class="photos" data-count={Math.min(e.photos.length, PREVIEW)}>
                      {e.photos.slice(0, PREVIEW).map((p, i) => (
                        <button
                          type="button"
                          class="photo"
                          data-gallery={e.id}
                          data-index={i}
                          aria-label={`Otvori fotografiju ${i + 1} od ${e.photos.length}`}
                        >
                          <img src={p.thumb} alt="" loading="lazy" decoding="async" />
                          {i === PREVIEW - 1 && e.photos.length > PREVIEW && (
                            <span class="more">+{e.photos.length - PREVIEW}</span>
                          )}
                        </button>
                      ))}
                    </div>
                  ) : (
                    <div class="no-photo" aria-hidden="true">
                      <svg viewBox="0 0 240 90" preserveAspectRatio="xMidYMid slice">
                        <path d="M0 30 H70 L90 50 H150 L170 30 H240 M0 70 H40 L55 55 M200 70 H240 M120 50 V90" />
                        <circle cx="70" cy="30" r="6" />
                        <circle cx="170" cy="30" r="6" />
                        <circle cx="55" cy="55" r="6" />
                        <circle cx="120" cy="50" r="6" />
                      </svg>
                      <span>{e.city}</span>
                    </div>
                  )}

                  <div class="actions">
                    <details class="more-text">
                      <summary>Opširnije</summary>
                      {e.venue && <p class="venue">{e.venue}</p>}
                      {e.paragraphs.map((para) => <p>{para}</p>)}
                    </details>
                    {e.link && (
                      <a href={e.link} target="_blank" rel="noopener noreferrer" class="meetup">
                        {e.linkLabel}
                      </a>
                    )}
                  </div>
                </div>

                {e.photos.length > 0 && (
                  <script
                    type="application/json"
                    data-photos={e.id}
                    set:html={JSON.stringify({ title: e.title, photos: e.photos.map((p) => p.src) })}
                  />
                )}
              </article>
            ))}
          </section>
        ))}

        <p class="empty" hidden>Nema događaja u ovom gradu.</p>
      </div>

      <div class="cta-section">
        <h2>Želite da učestvujete?</h2>
        <p>
          Kontaktirajte nas ako želite da organizujete radionicu, učestvujete u
          pripremi događaja ili imate ideju za saradnju.
        </p>
        <a href="/contact" class="cta-button">
          Kontaktirajte nas
          <Icon name="ic:baseline-chevron-right" />
        </a>
      </div>
    </div>
  </Container>

  <dialog class="viewer" aria-label="Fotografije događaja">
    <figure>
      <img alt="" />
      <figcaption><span class="viewer-title"></span> <span class="viewer-count"></span></figcaption>
    </figure>
    <button type="button" class="viewer-btn viewer-prev" aria-label="Prethodna fotografija">
      <Icon name="ic:baseline-chevron-left" />
    </button>
    <button type="button" class="viewer-btn viewer-next" aria-label="Sledeća fotografija">
      <Icon name="ic:baseline-chevron-right" />
    </button>
    <button type="button" class="viewer-btn viewer-close" aria-label="Zatvori">
      <Icon name="ic:baseline-close" />
    </button>
  </dialog>
</Layout>

<script>
  const timeline = document.querySelector(".timeline");
  const fill = document.querySelector(".trace-fill");
  const entries = [...document.querySelectorAll(".entry")];
  const dots = new Map([...document.querySelectorAll(".strip-dot")].map((d) => [d.dataset.id, d]));
  const cursor = document.querySelector(".strip-cursor");

  // Scroll-linked "power on": the trace fills down to the reading line and lights each pad it reaches.
  let current = null;
  function update() {
    const line = window.innerHeight * 0.45;
    const box = timeline.getBoundingClientRect();
    const reach = Math.min(Math.max(line - box.top, 0), box.height);
    fill.style.height = `${reach}px`;

    let active = null;
    for (const entry of entries) {
      if (entry.hidden) continue;
      const lit = entry.getBoundingClientRect().top < line;
      entry.classList.toggle("is-lit", lit);
      if (lit) active = entry;
    }
    active ??= entries.find((e) => !e.hidden);
    if (active && active !== current) {
      current?.classList.remove("is-current");
      dots.get(current?.dataset.id)?.classList.remove("is-current");
      current = active;
      current.classList.add("is-current");
      const dot = dots.get(current.dataset.id);
      dot?.classList.add("is-current");
      if (dot) cursor.style.left = dot.style.left;
    }
  }
  let ticking = false;
  const schedule = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      update();
    });
  };
  window.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule);
  update();

  // City filter
  const chips = [...document.querySelectorAll(".chip")];
  const years = [...document.querySelectorAll(".year")];
  const empty = document.querySelector(".empty");
  for (const chip of chips) {
    chip.addEventListener("click", () => {
      const city = chip.dataset.city;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      for (const entry of entries) entry.hidden = Boolean(city) && entry.dataset.city !== city;
      for (const dot of dots.values()) dot.classList.toggle("is-dim", Boolean(city) && dot.dataset.city !== city);
      for (const year of years) year.hidden = !year.querySelector(".entry:not([hidden])");
      empty.hidden = years.some((y) => !y.hidden);
      current?.classList.remove("is-current");
      dots.get(current?.dataset.id)?.classList.remove("is-current");
      current = null;
      update();
    });
  }

  // Photo viewer
  const viewer = document.querySelector(".viewer");
  const img = viewer.querySelector("img");
  const title = viewer.querySelector(".viewer-title");
  const count = viewer.querySelector(".viewer-count");
  let gallery = null;
  let index = 0;

  function show(i) {
    index = (i + gallery.photos.length) % gallery.photos.length;
    img.src = gallery.photos[index];
    img.alt = `${gallery.title}, fotografija ${index + 1}`;
    title.textContent = gallery.title;
    count.textContent = `${index + 1} / ${gallery.photos.length}`;
  }

  document.addEventListener("click", (event) => {
    const button = event.target.closest(".photo");
    if (!button) return;
    const data = document.querySelector(`[data-photos="${button.dataset.gallery}"]`);
    gallery = JSON.parse(data.textContent);
    show(Number(button.dataset.index));
    viewer.showModal();
  });
  viewer.querySelector(".viewer-prev").addEventListener("click", () => show(index - 1));
  viewer.querySelector(".viewer-next").addEventListener("click", () => show(index + 1));
  viewer.querySelector(".viewer-close").addEventListener("click", () => viewer.close());
  viewer.addEventListener("click", (event) => {
    if (event.target === viewer) viewer.close();
  });
  viewer.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") show(index - 1);
    if (event.key === "ArrowRight") show(index + 1);
  });
</script>

<style>
  .events-page {
    --ink: var(--theme-on-bg);
    --muted: color-mix(in srgb, var(--theme-on-bg) 62%, transparent);
    --hairline: color-mix(in srgb, var(--theme-on-bg) 18%, transparent);
    --lit: var(--theme-surface-2);
  }

  .intro {
    max-width: 38rem;
    margin: 3rem 0 2rem;
  }

  .intro h1 {
    font-size: var(--font-size-xxl);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .intro p {
    color: var(--muted);
    margin: 0;
  }

  /* Overview strip */
  .overview {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--theme-bg);
    padding: 1rem 0 0.75rem;
    border-bottom: 1px solid var(--hairline);
  }

  .strip {
    position: relative;
    height: 3.25rem;
    margin: 0 0.5rem;
  }

  .strip-axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 2rem;
    height: 2px;
    background: var(--hairline);
  }

  .strip-year {
    position: absolute;
    top: 0;
    padding-left: 0.4rem;
    border-left: 2px solid var(--hairline);
    height: 2.4rem;
    font-family: var(--theme-font-family-serif);
    font-size: var(--font-size-sm);
    line-height: 1;
  }

  .strip-dot {
    position: absolute;
    top: 2rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--theme-bg);
    transform: translate(-50%, -50%) translateY(1px);
    transition: transform var(--theme-transition), opacity var(--theme-transition);
  }

  .strip-dot.has-photos {
    background: var(--ink);
  }

  .strip-dot:hover,
  .strip-dot:focus-visible,
  .strip-dot.is-current {
    transform: translate(-50%, -50%) translateY(1px) scale(1.6);
    z-index: 1;
  }

  .strip-dot.is-dim {
    opacity: 0.15;
    pointer-events: none;
  }

  .strip-cursor {
    position: absolute;
    top: 2.6rem;
    width: 0;
    height: 0;
    border: 0.4rem solid transparent;
    border-bottom-color: var(--ink);
    transform: translateX(-50%);
    transition: left 0.3s ease;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    font: inherit;
    font-size: var(--font-size-sm);
    color: var(--ink);
    background: none;
    border: 1px solid var(--hairline);
    border-radius: var(--theme-button-border-radius);
    padding: 0.3rem 0.85rem;
    cursor: pointer;
  }

  .chip span {
    color: var(--muted);
    margin-left: 0.25rem;
  }

  .chip[aria-pressed="true"] {
    background: var(--ink);
    color: var(--theme-bg);
    border-color: var(--ink);
  }

  .chip[aria-pressed="true"] span {
    color: inherit;
    opacity: 0.7;
  }

  /* Timeline */
  .timeline {
    --date-col: 4.5rem;
    --trace-x: calc(var(--date-col) + 1.25rem);
    position: relative;
    margin: 2.5rem 0 4rem;
  }

  .trace {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--trace-x);
    width: 4px;
    margin-left: -2px;
    background: var(--hairline);
    border-radius: 2px;
  }

  .trace-fill {
    width: 100%;
    background: var(--ink);
    border-radius: 2px;
  }

  .year-label {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 2rem;
    padding-left: calc(var(--trace-x) - 1.1rem);
    font-size: var(--font-size-xl);
    line-height: 1;
  }

  .year-pad {
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 4px solid var(--ink);
    background: var(--theme-bg);
    box-shadow: 0 0 0 6px var(--theme-bg);
  }

  .year + .year {
    margin-top: 3.5rem;
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: var(--date-col) 2.5rem minmax(0, 1fr);
    margin-bottom: 3rem;
    scroll-margin-top: 9rem;
  }

  .when {
    text-align: right;
    font-family: var(--theme-font-family-serif);
    line-height: 1;
    padding-top: 0.15rem;
  }

  .day {
    display: block;
    font-size: var(--font-size-lg);
    font-variant-numeric: tabular-nums;
  }

  .month {
    font-size: var(--font-size-sm);
    color: var(--muted);
  }

  .pad {
    justify-self: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.5rem;
    border-radius: 50%;
    border: 3px solid var(--ink);
    background: var(--theme-bg);
    box-shadow: 0 0 0 5px var(--theme-bg);
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }

  .entry.is-lit .pad {
    background: var(--ink);
  }

  .entry.is-current .pad {
    box-shadow: 0 0 0 5px var(--theme-bg), 0 0 0 10px var(--lit);
  }

  .body {
    max-width: 44rem;
    padding-left: 0.75rem;
  }

  .body h3 {
    font-size: var(--font-size-md);
    line-height: 1.2;
    margin: 0 0 0.4rem;
  }

  .where {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--font-size-sm);
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .where :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .summary {
    margin: 0 0 1rem;
    max-width: 38rem;
  }

  .photos {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: repeat(2, 1fr);
    gap: 0.4rem;
    max-width: 34rem;
    aspect-ratio: 2 / 1;
    margin-bottom: 1rem;
  }

  .photos[data-count="1"] {
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    max-width: 20rem;
    aspect-ratio: 4 / 3;
  }

  .photos[data-count="2"] {
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr;
    max-width: 28rem;
  }

  .photos[data-count="3"] {
    grid-template-columns: 2fr 1fr;
  }

  .photo {
    position: relative;
    padding: 0;
    border: 0;
    background: var(--theme-surface-1);
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 0.4rem;
  }

  .photo:first-child {
    grid-row: 1 / -1;
  }

  .photos[data-count="4"] .photo:nth-child(4) {
    grid-column: 2 / 4;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .photo:hover img {
    transform: scale(1.04);
  }

  .photo:focus-visible,
  .chip:focus-visible,
  .strip-dot:focus-visible,
  .more-text summary:focus-visible,
  .meetup:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-family: var(--theme-font-family-serif);
    font-size: var(--font-size-md);
  }

  .no-photo {
    position: relative;
    height: 5.5rem;
    margin-bottom: 1rem;
    border-radius: 0.4rem;
    background: var(--theme-surface-2);
    color: var(--theme-on-surface-2);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 0.6rem 0.9rem;
  }

  .no-photo svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    opacity: 0.35;
  }

  .no-photo circle {
    fill: var(--theme-surface-2);
  }

  .no-photo span {
    position: relative;
    font-family: var(--theme-font-family-serif);
    font-size: var(--font-size-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }

  .more-text summary {
    display: inline-block;
    cursor: pointer;
    font-weight: 700;
  }

  .more-text[open] {
    order: 2;
    flex-basis: 100%;
  }

  .more-text[open] summary {
    margin-bottom: 0.75rem;
  }

  .more-text p {
    max-width: 38rem;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .venue {
    font-size: var(--font-size-sm);
    color: var(--muted);
  }

  .meetup {
    color: var(--ink);
    font-size: var(--font-size-sm);
  }

  .empty {
    padding-left: calc(var(--trace-x) + 2rem);
  }

  /* Photo viewer */
  .viewer {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.96);
    color: #fff;
  }

  .viewer::backdrop {
    background: transparent;
  }

  .viewer figure {
    height: 100%;
    margin: 0;
    padding: 3.5rem 4.5rem 3rem;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.75rem;
    justify-items: center;
  }

  .viewer img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .viewer figcaption {
    font-size: var(--font-size-sm);
    text-align: center;
  }

  .viewer-count {
    opacity: 0.7;
    margin-left: 0.5rem;
  }

  .viewer-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    cursor: pointer;
  }

  .viewer-btn:hover {
    background: rgb(255 255 255 / 0.25);
  }

  .viewer-btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .viewer-btn :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
  }

  .viewer-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .viewer-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .viewer-close {
    top: 0.75rem;
    right: 1rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
